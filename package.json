{
  "name": "@matheuspolli/doc-guard",
  "version": "0.1.2",
  "description": "Validação, formatação e geração de documentos brasileiros: CPF, CNPJ (inclusive alfanumérico 2026) e Inscrição Estadual das 27 UFs.",
  "keywords": [
    "cpf",
    "cnpj",
    "cnpj-alfanumerico",
    "inscricao-estadual",
    "ie",
    "validacao",
    "brasil",
    "sintegra",
    "gerador",
    "validator",
    "generator",
    "typescript"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Matheus Gasparotto Polli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaatheusPolli/doc-guard.git"
  },
  "homepage": "https://github.com/MaatheusPolli/doc-guard#readme",
  "bugs": {
    "url": "https://github.com/MaatheusPolli/doc-guard/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cpf": {
      "import": {
        "types": "./dist/cpf/index.d.ts",
        "default": "./dist/cpf/index.js"
      },
      "require": {
        "types": "./dist/cpf/index.d.cts",
        "default": "./dist/cpf/index.cjs"
      }
    },
    "./cnpj": {
      "import": {
        "types": "./dist/cnpj/index.d.ts",
        "default": "./dist/cnpj/index.js"
      },
      "require": {
        "types": "./dist/cnpj/index.d.cts",
        "default": "./dist/cnpj/index.cjs"
      }
    },
    "./ie": {
      "import": {
        "types": "./dist/ie/index.d.ts",
        "default": "./dist/ie/index.js"
      },
      "require": {
        "types": "./dist/ie/index.d.cts",
        "default": "./dist/ie/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "changeset": "changeset",
    "prepublishOnly": "npm run build",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
